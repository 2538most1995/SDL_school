Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    # Application-owned assets bypass Laravel. Keep coverage local to this
    # directory; never add CORS or a second CSP over the nonce-bearing HTML.
    Header always set X-Content-Type-Options "nosniff"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" "expr=%{HTTPS} == 'on'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve only Laravel's public assets from the application subdirectory.
    RewriteRule ^(?:SDL_school/)?(build|storage|images)/(.*)$ laravel-app/public/$1/$2 [END]
    RewriteRule ^(?:SDL_school/)?(favicon\.ico|robots\.txt)$ laravel-app/public/$1 [END]

    # Keep the project-level front controller as the visible PHP entry point.
    # This lets Laravel detect /SDL_school as its base URL correctly.
    RewriteRule ^index\.php$ - [L]
    RewriteRule ^ index.php [L,QSA]
</IfModule>

<IfModule mod_mime.c>
    AddType text/javascript .mjs
    AddType application/wasm .wasm
</IfModule>
